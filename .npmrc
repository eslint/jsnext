# `@babel/eslint-parser` declares a peer range of `eslint@^7 || ^8 || ^9`, and
# this repository is on ESLint 10. Nothing here loads the two together —
# `@babel/eslint-parser` is a contender in the parser benchmark and nothing
# else — so the conflict is a stale range rather than a real incompatibility.
# Without this, a clean `npm install` and `npm ci` both fail outright, which
# means CI cannot install at all.
legacy-peer-deps=true
