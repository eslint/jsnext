{
	"name": "jsparse-monorepo",
	"version": "0.0.0",
	"description": "A fast, ESLint-compatible parser and scope analyzer for JavaScript and TypeScript.",
	"type": "module",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"lint": "npm run build && eslint .",
		"bench": "npm run bench --workspaces --if-present",
		"conformance": "npm run conformance --workspaces --if-present"
	},
	"keywords": [
		"parser",
		"scope",
		"javascript",
		"typescript",
		"eslint",
		"estree",
		"ast"
	],
	"author": "",
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.2.0",
		"@typescript-eslint/parser": "^8.0.0",
		"@typescript-eslint/scope-manager": "^8.0.0",
		"@typescript-eslint/types": "^8.0.0",
		"acorn": "^8.12.0",
		"esbuild": "^0.24.0",
		"eslint": "^10.8.1",
		"eslint-scope": "^9.0.0",
		"espree": "^10.0.0",
		"globals": "^17.9.0",
		"typescript": "^5.6.0",
		"typescript-6": "npm:typescript@^6.0.3",
		"typescript-7": "npm:typescript@^7.0.2",
		"vitest": "^2.0.0"
	},
	"allowScripts": {
		"esbuild@0.24.2": true,
		"esbuild@0.21.5": true,
		"esbuild@0.25.12": true,
		"esbuild@0.27.7": true,
		"sharp@0.34.5": true
	}
}
