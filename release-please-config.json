{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "plugins": [
    "node-workspace",
    {
      "type": "linked-versions",
      "groupName": "jskit",
      "components": [
        "jskit",
        "jskit-native",
        "jskit-native-darwin-arm64",
        "jskit-native-darwin-x64",
        "jskit-native-linux-arm64-gnu",
        "jskit-native-linux-x64-gnu",
        "jskit-native-win32-x64"
      ]
    }
  ],
  "bump-minor-pre-major": true,
  "extra-label": "triage:no",
  "pull-request-title-pattern": "chore: release${component} ${version}",
  "packages": {
    "packages/jskit": {
      "release-as": "0.1.0",
      "release-type": "node",
      "component": "jskit"
    },
    "packages/jskit-native": {
      "release-as": "0.1.0",
      "release-type": "node",
      "component": "jskit-native"
    },
    "packages/jskit-native/npm/darwin-arm64": {
      "release-as": "0.1.0",
      "release-type": "node",
      "component": "jskit-native-darwin-arm64"
    },
    "packages/jskit-native/npm/darwin-x64": {
      "release-as": "0.1.0",
      "release-type": "node",
      "component": "jskit-native-darwin-x64"
    },
    "packages/jskit-native/npm/linux-arm64-gnu": {
      "release-as": "0.1.0",
      "release-type": "node",
      "component": "jskit-native-linux-arm64-gnu"
    },
    "packages/jskit-native/npm/linux-x64-gnu": {
      "release-as": "0.1.0",
      "release-type": "node",
      "component": "jskit-native-linux-x64-gnu"
    },
    "packages/jskit-native/npm/win32-x64": {
      "release-as": "0.1.0",
      "release-type": "node",
      "component": "jskit-native-win32-x64"
    }
  }
}
