dist
node_modules

# The default place to clone test262, which `npm run conformance:262
# --workspace=@eslint/jskit` reads. It is a large checkout of somebody
# else's repository; see packages/jskit/scripts/README.md.
/test262

# What `npm run bench:chart` produces. Regenerable in one command, and a
# committed benchmark number is stale the moment the parser changes.
packages/jskit/benchmarks/*/results.json
packages/jskit/benchmarks/*/results.svg

# What `npm run test:coverage` writes. Regenerable in one command.
coverage

# Cargo's build directory and the compiled Node-API binary, both produced by
# `npm run build --workspace=@eslint/jskit-native`. The binary is
# platform-specific; a machine without Rust runs the TypeScript
# implementation instead.
packages/jskit-native/target/
packages/jskit-native/*.node
