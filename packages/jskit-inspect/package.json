{
  "name": "@eslint/jskit-inspect",
  "version": "0.0.0",
  "description": "A web app for inspecting how @eslint/jskit parses, scopes, and graphs a program.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "astro build",
    "lint": "npm run lint:types",
    "lint:types": "tsc --noEmit",
    "prebuild": "npm run build --workspace=@eslint/jskit",
    "prelint:types": "npm run build --workspace=@eslint/jskit",
    "prestart": "npm run build --workspace=@eslint/jskit",
    "start": "astro dev",
    "start:preview": "astro preview"
  },
  "keywords": [
    "ast",
    "scope",
    "control-flow",
    "javascript",
    "typescript",
    "eslint"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@eslint/jskit": "^0.0.0",
    "@radix-ui/react-tabs": "^1.1.2",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.2.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.1",
    "mermaid": "^11.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
